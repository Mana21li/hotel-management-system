# Copy this file to `.env` and adjust values as needed:
#
#     cp .env.example .env
#
# The real `.env` file is gitignored so your credentials never get committed.
# These values configure the PostgreSQL container in docker-compose.yml.

# Shared credentials for both Postgres containers.
POSTGRES_USER=user
POSTGRES_PASSWORD=local_password

# Per-service databases (one Postgres container each).
HOTEL_POSTGRES_DB=hotel_catalog
BOOKING_POSTGRES_DB=hotel_booking
USER_POSTGRES_DB=hotel_user

# Host ports — hotel-db :5433, booking-db :5434, user-db :5435 (5432 free for local Postgres).
HOTEL_POSTGRES_PORT=5433
BOOKING_POSTGRES_PORT=5434
USER_POSTGRES_PORT=5435

# Host port to expose Redis on. Default Redis port is 6379. Change if taken.
REDIS_PORT=6379

# Elasticsearch HTTP API (Spring app and curl connect here).
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URI=http://localhost:9200

# Kibana web UI for inspecting indices (optional but useful for learning).
KIBANA_PORT=5601

# Kafka broker — Spring Boot and kafka-console-* CLI connect from your Mac.
# (App on Mac → localhost:9092; containers inside Docker → kafka:9094)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka UI — browse topics, messages, consumer groups in a browser.
KAFKA_UI_PORT=8081

# Host port for the containerized strangler/gateway (docker compose --profile app).
# Leave the app profile off to keep running each service via ./gradlew bootRun.
APP_PORT=8080

# Extracted notification-service (docker compose --profile app up -d).
NOTIFICATION_SERVICE_PORT=8082

# Extracted analytics-service / recommendation-service.
ANALYTICS_SERVICE_PORT=8084
ANALYTICS_SERVICE_URL=http://localhost:8084
RECOMMENDATION_SERVICE_PORT=8085
RECOMMENDATION_SERVICE_URL=http://localhost:8085

# Extracted search-service.
SEARCH_SERVICE_PORT=8083
SEARCH_SERVICE_URL=http://localhost:8083

# Extracted hotel-service.
HOTEL_SERVICE_PORT=8086
HOTEL_SERVICE_URL=http://localhost:8086

# Extracted booking-service (lock + EXCLUDE + outbox).
BOOKING_SERVICE_PORT=8087
BOOKING_SERVICE_URL=http://localhost:8087

# Extracted user-service.
USER_SERVICE_PORT=8088
USER_SERVICE_URL=http://localhost:8088

# SonarQube Community Edition UI (docker compose --profile sonar up -d).
# Open http://localhost:9000 — default login admin/admin (change on first use).
SONARQUBE_PORT=9000
