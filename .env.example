# Copy this file to `.env` and adjust values as needed:
#
#     cp .env.example .env
#
# The real `.env` file is gitignored so your credentials never get committed.
# These values configure the PostgreSQL container in docker-compose.yml.

# Database superuser name.
POSTGRES_USER=user

# Database password. Change this to anything for local dev — it never leaves
# your machine. Do NOT reuse a real/important password here.
POSTGRES_PASSWORD=local_password

# The database that gets created automatically on first startup.
POSTGRES_DB=hotel_management

# Host port to expose Postgres on. Default Postgres port is 5432. If you
# already have something on 5432, change this to e.g. 5433.
POSTGRES_PORT=5432

# Host port to expose Redis on. Default Redis port is 6379. Change if taken.
REDIS_PORT=6379

# Elasticsearch HTTP API (Spring app and curl connect here).
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URI=http://localhost:9200

# Kibana web UI for inspecting indices (optional but useful for learning).
KIBANA_PORT=5601

# Kafka broker — Spring Boot and kafka-console-* CLI connect from your Mac.
# (App on Mac → localhost:9092; containers inside Docker → kafka:9094)
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka UI — browse topics, messages, consumer groups in a browser.
KAFKA_UI_PORT=8081
