# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.iml
*.ipr
*.iws
.cursor/
*.swp
*.swo

# Postman — local API client workspace (use docs/api/*.md as the shared contract)
postman/
.postman/

# Logs
*.log
logs/

# Environment
.env
.env.local
.env.*.local

# Database dumps / backups (may be large and can contain real data)
*.dump
*.sql.gz
*.sql.bak
*.bak
backups/

# Local database data (if ever bind-mounted instead of a named volume)
pgdata/
db/data/

# Dependencies (common ecosystems — keep harmless if unused)
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Heap dumps (never commit — these can be hundreds of MB)
*.hprof

# Build output
dist/
build/
out/
target/
.gradle/

# Spring Boot / Gradle (backend module keeps its own .gitignore too)
backend/.gradle/
backend/build/
backend/bin/
notification-service/.gradle/
notification-service/build/
notification-service/bin/
search-service/.gradle/
search-service/build/
search-service/bin/
analytics-service/.gradle/
analytics-service/build/
analytics-service/bin/
recommendation-service/.gradle/
recommendation-service/build/
recommendation-service/bin/
hotel-service/.gradle/
hotel-service/build/
hotel-service/bin/
booking-service/.gradle/
booking-service/build/
booking-service/bin/
